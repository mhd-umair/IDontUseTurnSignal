@page "/admin/dashboard"
@using TurnSignalTracker.Models
@using TurnSignalTracker.Services
@inject IAIService AIService
@inject IDriverService DriverService
@inject IJSRuntime JS
@inject NavigationManager Navigation
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Admin Portal | TurnSignalTracker</PageTitle>

<div class="max-w-4xl mx-auto">
    <div class="mb-8">
        <h2 class="text-3xl font-bold text-slate-900">Admin Portal</h2>
        <p class="text-slate-500">Log new violations using AI voice processing.</p>
    </div>

    <!-- Voice Input Section -->
    <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-8 mb-8 text-center transition-all hover:shadow-xl">
        <div class="mb-6">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full @(_isRecording ? "bg-red-100 animate-pulse" : "bg-blue-100") mb-4 cursor-pointer hover:bg-opacity-80 transition-colors"
                 @onclick="ToggleRecording">
                <span class="text-3xl">@(_isRecording ? "⏹️" : "🎙️")</span>
            </div>
            <h3 class="text-xl font-semibold text-slate-800">
                @(_isRecording ? "Listening..." : "Tap to Report Violation")
            </h3>
            <p class="text-slate-500 mt-2">
                @(_isRecording ? "Speak now. Describe the car and violation." : "Example: 'Black BMW X5 turned left on Main Street without signal'")
            </p>
        </div>

        @if (!string.IsNullOrEmpty(_transcript))
        {
            <div class="bg-gray-50 p-4 rounded-lg text-left mb-6 border border-gray-200">
                <span class="text-xs font-bold text-gray-500 uppercase">Transcript</span>
                <p class="text-gray-800 italic">"@_transcript"</p>
            </div>
        }

        @if (_isProcessing)
        {
            <div class="flex items-center justify-center gap-2 text-blue-600 font-semibold animate-pulse">
                <span>🤖 AI Processing...</span>
            </div>
        }
    </div>

    <!-- Review & Submit Section -->
    @if (_draftDriver != null && !_isProcessing)
    {
        <div class="bg-white rounded-2xl shadow-lg border border-slate-100 p-8 animate-fade-in-up">
            <h3 class="text-xl font-bold text-slate-800 mb-6 flex items-center gap-2">
                <span>📋</span> Review & Submit
            </h3>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Make</label>
                    <input @bind="_draftDriver.CarMake" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Model</label>
                    <input @bind="_draftDriver.CarModel" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Color</label>
                    <input @bind="_draftDriver.CarColor" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow" />
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Year</label>
                    <input @bind="_draftDriver.CarYear" type="number" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow" />
                </div>
                <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Location (from GPS/Voice)</label>
                    <input @bind="_draftDriver.Location" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow" />
                    <div class="text-xs text-gray-400 mt-1">
                        GPS: @(_draftDriver.Latitude?.ToString("F4") ?? "N/A"), @(_draftDriver.Longitude?.ToString("F4") ?? "N/A")
                    </div>
                </div>
                 <div class="md:col-span-2">
                    <label class="block text-sm font-medium text-slate-700 mb-1">Violation</label>
                    <input @bind="_draftDriver.ViolationType" class="w-full px-4 py-2 border rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-shadow" />
                </div>
            </div>

            <div class="flex gap-4">
                <button @onclick="SaveViolation" class="flex-1 bg-blue-600 text-white font-bold py-3 px-6 rounded-xl hover:bg-blue-700 transition-colors shadow-md hover:shadow-lg">
                    Confirm & Save
                </button>
                <button @onclick="Discard" class="px-6 py-3 text-slate-600 font-semibold hover:bg-slate-50 rounded-xl transition-colors">
                    Discard
                </button>
            </div>
        </div>
    }
</div>

<script>
    window.startSpeechRecognition = (dotnetHelper) => {
        if (!('webkitSpeechRecognition' in window)) {
            alert("Web Speech API not supported in this browser.");
            return;
        }
        
        const recognition = new webkitSpeechRecognition();
        recognition.continuous = false;
        recognition.interimResults = false;
        recognition.lang = 'en-US';

        recognition.onstart = () => { console.log('Listening...'); };
        
        recognition.onresult = (event) => {
            const transcript = event.results[0][0].transcript;
            dotnetHelper.invokeMethodAsync('OnSpeechRecognized', transcript);
        };

        recognition.onerror = (event) => {
            console.error('Speech error', event.error);
            dotnetHelper.invokeMethodAsync('OnSpeechError', event.error);
        };

        recognition.start();
    };

    window.getGeolocation = (dotnetHelper) => {
        if (navigator.geolocation) {
             navigator.geolocation.getCurrentPosition(
                (position) => {
                    dotnetHelper.invokeMethodAsync('OnLocationReceived', position.coords.latitude, position.coords.longitude);
                },
                (error) => {
                    console.error("Geolocation error", error);
                    // Still proceed without location
                    dotnetHelper.invokeMethodAsync('OnLocationReceived', null, null);
                }
            );
        } else {
             dotnetHelper.invokeMethodAsync('OnLocationReceived', null, null);
        }
    }
</script>

@code {
    private bool _isRecording = false;
    private bool _isProcessing = false;
    private string _transcript = "";
    private BadDriver? _draftDriver;
    private DotNetObjectReference<Dashboard>? _objRef;
    
    // Temp storage for location until voice is done
    private double? _lat;
    private double? _lon;

    protected override void OnInitialized()
    {
        _objRef = DotNetObjectReference.Create(this);
    }

    private async Task ToggleRecording()
    {
        if (_isRecording) return; // Wait for end
        
        _isRecording = true;
        _draftDriver = null;
        _transcript = "";
        
        // Start Geolocation in parallel
        await JS.InvokeVoidAsync("getGeolocation", _objRef);
        // Start Speech
        await JS.InvokeVoidAsync("startSpeechRecognition", _objRef);
    }

    [JSInvokable]
    public void OnLocationReceived(double? lat, double? lon)
    {
        _lat = lat;
        _lon = lon;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnSpeechRecognized(string text)
    {
        _isRecording = false;
        _transcript = text;
        _isProcessing = true;
        StateHasChanged();

        try 
        {
            _draftDriver = await AIService.ProcessVoiceLogAsync(_transcript, _lat, _lon);
        }
        finally
        {
            _isProcessing = false;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public void OnSpeechError(string error)
    {
        _isRecording = false;
        Console.WriteLine($"Speech Error: {error}");
        StateHasChanged();
    }

    private async Task SaveViolation()
    {
        if (_draftDriver != null)
        {
            try
            {
                await DriverService.AddAsync(_draftDriver);
                _draftDriver = null;
                _transcript = "";
                // Show success toast or something? For now just reset.
            } 
            catch (Exception ex)
            {
                Console.WriteLine($"Save failed: {ex.Message}");
                // In demo w/o DB, we just clear it
                 _draftDriver = null;
                 _transcript = "";
            }
        }
    }

    private void Discard()
    {
        _draftDriver = null;
        _transcript = "";
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }
}
