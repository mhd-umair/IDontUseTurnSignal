@page "/"
@inject TurnSignalTracker.Services.IDriverService DriverService
@inject TurnSignalTracker.Services.IAIInsightsService InsightsService
@inject IJSRuntime JS
@using TurnSignalTracker.Models
@using TurnSignalTracker.Services

<PageTitle>Dashboard | TurnSignalTracker</PageTitle>

<div class="space-y-8">
    <div class="flex justify-between items-center">
        <div>
            <h2 class="text-3xl font-bold text-slate-800">Public Dashboard</h2>
            <p class="text-slate-500 mt-1">Tracking turn signal violations in real-time.</p>
        </div>
        <div class="text-right">
            <div class="text-sm text-slate-500">Total Violations</div>
            <div class="text-3xl font-bold text-blue-600">@_totalViolations</div>
        </div>
    </div>

    <!-- AI Insights Section -->
    @if (!string.IsNullOrEmpty(_aiInsights))
    {
        <div class="bg-gradient-to-r from-violet-50 to-purple-50 rounded-xl border border-violet-100 p-6">
            <div class="flex items-start gap-3">
                <span class="text-2xl">🤖</span>
                <div>
                    <h3 class="text-lg font-semibold text-violet-900 mb-1">AI Insights</h3>
                    <p class="text-violet-800 leading-relaxed">@_aiInsights</p>
                    @if (_insightsLoading)
                    {
                        <p class="text-xs text-violet-500 mt-2 animate-pulse">Refreshing insights...</p>
                    }
                </div>
            </div>
        </div>
    }

    <!-- Charts Section -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
            <h3 class="text-lg font-semibold mb-4 text-slate-700">Top Offenders by Make</h3>
            <canvas id="makeChart"></canvas>
        </div>
        
        <div class="bg-white p-6 rounded-xl shadow-sm border border-slate-100">
             <h3 class="text-lg font-semibold mb-4 text-slate-700">Recent Violations</h3>
             <div class="overflow-hidden">
                 <table class="min-w-full text-left text-sm whitespace-nowrap">
                     <thead class="uppercase tracking-wider border-b-2 border-gray-100">
                         <tr>
                             <th scope="col" class="px-2 py-3 text-slate-500 font-medium">Make</th>
                             <th scope="col" class="px-2 py-3 text-slate-500 font-medium">Model</th>
                             <th scope="col" class="px-2 py-3 text-slate-500 font-medium">Color</th>
                             <th scope="col" class="px-2 py-3 text-slate-500 font-medium">Violation</th>
                         </tr>
                     </thead>
                     <tbody class="divide-y divide-gray-100">
                         @foreach (var v in _recentViolations.Take(5))
                         {
                             <tr class="hover:bg-gray-50 transition-colors">
                                 <td class="px-2 py-3 font-medium text-slate-900 flex items-center gap-2">
                                     <!-- Simple Logo Placeholder based on text -->
                                     <img src="@GetLogoUrl(v.CarMake)" alt="@v.CarMake" class="w-6 h-6 object-contain" onError="this.style.display='none'"/>
                                     @v.CarMake
                                 </td>
                                 <td class="px-2 py-3 text-slate-600">@v.CarModel</td>
                                 <td class="px-2 py-3 text-slate-600">@v.CarColor</td>
                                 <td class="px-2 py-3 text-red-500 text-xs font-semibold uppercase bg-red-50 rounded-full px-2 inline-block">@v.ViolationType</td>
                             </tr>
                         }
                     </tbody>
                 </table>
             </div>
        </div>
    </div>
</div>

<script>
    window.renderChart = (labels, data) => {
        const ctx = document.getElementById('makeChart');
        if(!ctx) return;
        
        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [{
                    label: '# of Violations',
                    data: data,
                    backgroundColor: [
                        'rgba(59, 130, 246, 0.8)',
                        'rgba(16, 185, 129, 0.8)', 
                        'rgba(245, 158, 11, 0.8)',
                        'rgba(239, 68, 68, 0.8)',
                        'rgba(139, 92, 246, 0.8)'
                    ],
                    borderRadius: 6,
                    borderWidth: 0
                }]
            },
            options: {
                responsive: true,
                scales: {
                    y: {
                        beginAtZero: true,
                        grid: { display: false }
                    },
                    x: {
                        grid: { display: false }
                    }
                },
                plugins: {
                    legend: { display: false }
                }
            }
        });
    }
</script>

@code {
    private IEnumerable<BadDriver> _recentViolations = Array.Empty<BadDriver>();
    private IEnumerable<BadDriverStats> _stats = Array.Empty<BadDriverStats>();
    private int _totalViolations = 0;
    private string _aiInsights = "";
    private bool _insightsLoading;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try 
            {
                // We fetch data in OnInitialized, but render chart here
                var labels = _stats.Select(s => s.CarMake).ToArray();
                var data = _stats.Select(s => s.Count).ToArray();
                await JS.InvokeVoidAsync("renderChart", labels, data);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error rendering chart: {ex.Message}");
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try 
        {
            _recentViolations = await DriverService.GetAllAsync();
            _stats = await DriverService.GetStatsAsync();
            _totalViolations = _recentViolations.Count();
        } 
        catch (Exception ex) 
        {
            Console.WriteLine($"DB Connection failed (expected in dev w/o SQL): {ex.Message}");
            // Fallback mock data for display purposes since we don't have SQL Server running
            _recentViolations = new List<BadDriver> 
            {
                new BadDriver { CarMake = "BMW", CarModel = "X5", CarColor = "Black", ViolationType = "No Signal", CreatedAt = DateTime.Now },
                new BadDriver { CarMake = "Tesla", CarModel = "Model 3", CarColor = "White", ViolationType = "Cut Off", CreatedAt = DateTime.Now.AddHours(-1) },
                new BadDriver { CarMake = "Audi", CarModel = "A4", CarColor = "Silver", ViolationType = "No Signal", CreatedAt = DateTime.Now.AddHours(-2) }
            };
            _stats = new List<BadDriverStats>
            {
                new BadDriverStats { CarMake = "BMW", Count = 15 },
                new BadDriverStats { CarMake = "Tesla", Count = 12 },
                new BadDriverStats { CarMake = "Audi", Count = 8 },
                new BadDriverStats { CarMake = "Honda", Count = 5 },
                new BadDriverStats { CarMake = "Ford", Count = 3 }
            };
            _totalViolations = 43;
        }

        await LoadInsightsAsync();
    }

    private async Task LoadInsightsAsync()
    {
        _insightsLoading = true;
        try
        {
            _aiInsights = await InsightsService.GenerateInsightsAsync(_recentViolations, _stats);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Insights error: {ex.Message}");
            _aiInsights = "AI insights are temporarily unavailable.";
        }
        finally
        {
            _insightsLoading = false;
        }
    }

    private string GetLogoUrl(string make)
    {
        // Simple CDN for car logos
        return $"https://cdn.worldvectorlogo.com/logos/{make.ToLower()}.svg";
    }
}
