@page "/login"
@layout Layout.MainLayout
@inject NavigationManager Navigation

<div class="flex items-center justify-center min-h-screen bg-gray-100">
    <div class="px-8 py-6 mt-4 text-left bg-white shadow-lg rounded-xl w-full max-w-md">
        <h3 class="text-2xl font-bold text-center text-gray-900">Admin Login</h3>
        <p class="mt-2 text-sm text-center text-gray-600">Sign in to track bad drivers</p>
        
        <form action="api/auth/login" method="post" class="mt-8 space-y-4">
            <div>
                <label class="block mb-2 text-sm font-bold text-gray-700" for="username">Username</label>
                <input type="text" name="username" placeholder="admin"
                    class="w-full px-4 py-2 text-gray-700 bg-gray-50 border rounded-lg focus:outline-none focus:border-blue-500 focus:bg-white" required>
            </div>
            <div>
                <label class="block mb-2 text-sm font-bold text-gray-700" for="password">Password</label>
                <input type="password" name="password" placeholder="password"
                    class="w-full px-4 py-2 text-gray-700 bg-gray-50 border rounded-lg focus:outline-none focus:border-blue-500 focus:bg-white" required>
            </div>
            
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />

            <button type="submit"
                class="w-full px-4 py-2 font-bold text-white bg-blue-600 rounded-lg hover:bg-blue-700 focus:outline-none focus:shadow-outline transition duration-300">
                Sign In
            </button>
        </form>
        
        @if (!string.IsNullOrEmpty(Error))
        {
            <div class="mt-4 p-3 bg-red-100 text-red-700 rounded-lg text-sm text-center">
                @Error
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [SupplyParameterFromQuery]
    public string? Error { get; set; }
}
